# Copy to .env.local and fill in real values. Never commit .env.local.

# Public base URL of the app (used for metadata and absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anon/publishable key (Project Settings > API).
# Safe for the browser — RLS is what actually restricts access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key (Project Settings > API). SECRET — server-only,
# bypasses RLS entirely. Never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack secret key (test mode — https://dashboard.paystack.com/#/settings/developer).
# SECRET — server-only. Checkout uses the redirect ("Standard") integration,
# so no public/client-side Paystack key is needed at all.
PAYSTACK_SECRET_KEY=
